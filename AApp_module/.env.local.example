# Backend API URL for blood group detection
NEXT_PUBLIC_API_URL=http://localhost:5000

# ESP32 Gateway API URL for vital signs (SpO2 and Heart Rate)
NEXT_PUBLIC_ESP32_API_URL=http://192.168.1.100/api/vitals

# Optional: Enable debug mode for health report system
NEXT_PUBLIC_DEBUG=false

# Optional: Default patient name for reports
NEXT_PUBLIC_DEFAULT_PATIENT_NAME=Patient
