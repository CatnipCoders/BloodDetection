# Next.js Application Configuration
# Copy this file to .env.local and update with your values

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# ESP32 Device URL
# Update with your ESP32's IP address
NEXT_PUBLIC_ESP32_API_URL=http://192.168.1.193/api/vitals

# SecuGen Scanner API URL
NEXT_PUBLIC_SECUGEN_API_URL=http://localhost:8443

# Application Settings
NEXT_PUBLIC_APP_NAME=Blood Group Detection System
NEXT_PUBLIC_APP_VERSION=1.0.0

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=false
