{
    "data": {
        "dataset_path": "dataset_blood_group",
        "img_size": [299, 299],
        "batch_size": 16,
        "test_split": 0.2
    },
    "model": {
        "architecture": "efficientnetb3",
        "input_shape": [299, 299, 3],
        "dense_layers": [512, 256, 128],
        "dropout_rates": [0.5, 0.3, 0.2],
        "learning_rate": 0.0001
    },
    "training": {
        "epochs": 100,
        "early_stopping_patience": 15,
        "save_best_only": true,
        "model_save_path": "models/blood_group_detection_model.keras"
    },
    "fine_tuning": {
        "enabled": true,
        "epochs": 50,
        "learning_rate": 0.00001,
        "unfreeze_layers": 50
    },
    "augmentation": {
        "rotation_range": 30,
        "width_shift_range": 0.2,
        "height_shift_range": 0.2,
        "zoom_range": 0.2,
        "horizontal_flip": true,
        "brightness_range": [0.8, 1.2]
    },
    "ensemble": {
        "enabled": true,
        "architectures": ["efficientnetb3", "resnet101", "densenet169"]
    },
    "tta": {
        "enabled": true,
        "steps": 10
    },
    "logging": {
        "level": "INFO",
        "log_dir": "logs"
    }
}